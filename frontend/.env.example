VITE_API_BASE_URL=/api

# From `sam deploy` outputs (infra/modules/api.yaml) — UserPoolId, UserPoolClientId.
# `make auth-run` writes these into .env.local automatically for local testing
# (see local/cognito/README.md) — set them here only for a real deployed pool.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Set only by `make auth-run` (local/cognito/README.md) to point Amplify at the
# local cognito-local server instead of real AWS Cognito. Leave empty/unset for
# production and for any .env.local pointed at a real deployed pool — when set,
# sign-in uses USER_PASSWORD_AUTH instead of the default SRP flow.
VITE_COGNITO_LOCAL_ENDPOINT=
